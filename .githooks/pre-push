#!/usr/bin/env bash
# Shared git hooks. Activate once per clone with:
#   git config core.hooksPath .githooks
set -euo pipefail

echo "pre-push: running fork guard (lint:skills, check-plugin-version)" >&2

npm run lint:skills
npm run check-plugin-version

if command -v claude >/dev/null 2>&1; then
  claude plugin validate . --strict
fi
